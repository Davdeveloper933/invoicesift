# Copy this file to ".env" and fill in your key. Never commit .env.

# Provider: openai (default) or anthropic.
LLM_PROVIDER=openai

# --- OpenAI (default) ---
OPENAI_API_KEY=sk-...
# Optional: model (default gpt-4o). Must support vision + structured outputs.
OPENAI_MODEL=gpt-4o

# --- Anthropic (optional alternative) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Validation website (web/) ---
# Password for the stats page at /admin.
ADMIN_TOKEN=change-me
# Postgres URL (e.g. free Neon database). Empty = local SQLite file in data/.
DATABASE_URL=
# Free invoices per visitor, and total invoices per day for everyone (protects your API budget).
DEMO_FREE_INVOICES=8
DEMO_GLOBAL_DAILY=300
# Header with the visitor's real IP, set by the CDN in front of the site (Cloudflare on Render).
# Leave empty on a host without Cloudflare - otherwise visitors could fake their IP.
TRUSTED_IP_HEADER=cf-connecting-ip
# Website only: API call timeout (seconds) and retries, so a stuck call frees its slot quickly.
DEMO_API_TIMEOUT=60
DEMO_API_RETRIES=2
# Owner mode: a browser that has logged into /admin has no free-invoice limit; max files per upload.
DEMO_OWNER_MAX_FILES=20
